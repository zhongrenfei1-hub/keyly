# 开发：复制为 .env.local。生产：在服务器上设成环境变量。

# 后台登录密码
ADMIN_PASSWORD=
# 给登录状态和订单访问签名用，至少 32 位随机字符。生成：openssl rand -base64 48
SESSION_SECRET=

# 可选：站点对外地址，接真实支付时用来拼回调地址，例如 https://keyly.example.com
SITE_URL=
# 可选：售后页显示的客服联系方式（这一项在 build 时写进页面，改了要重新 npm run build）
SUPPORT_CONTACT=
# 可选：数据库文件位置，默认 ./data/keyly.db
DATABASE_FILE=
# 模拟支付只在开发环境开放。设为 1 会在生产环境也开放，等于任何人都能不花钱拿货，正式站不要开。
ALLOW_MOCK_PAY=
